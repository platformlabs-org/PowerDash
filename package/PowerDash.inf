;
; PowerDash.inf - package descriptor for the PowerDash kernel driver
;
; Primitive driver package: stages the driver into the Driver Store and
; installs the 'powerdash' kernel service - no PnP device node. Runtime
; loading can alternatively be done by PowerDash.exe via the SCM (sc
; create/start) with its embedded copy of the same driver.
;
; Install : pnputil /add-driver PowerDash.inf /install
; Remove  : pnputil /delete-driver oem##.inf /uninstall /force
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=PowerDash.cat
DriverVer = 08/30/2026,1.0.0.0
PnpLockdown=1
PrimitiveDriver=1

[SourceDisksNames]
1 = %DiskName%,,

[SourceDisksFiles]
PowerDash.sys = 1,,

[DestinationDirs]
DefaultDestDir = 13                    ; DIRID 13 = Driver Store (isolated)

[DefaultInstall.NTamd64]
CopyFiles=Drivers_Dir

[Drivers_Dir]
PowerDash.sys

[DefaultInstall.NTamd64.Services]
AddService = powerdash,, PowerDash_Service_Inst

[PowerDash_Service_Inst]
DisplayName    = %PowerDash.SVCDESC%
ServiceType    = 1                     ; SERVICE_KERNEL_DRIVER
StartType      = 3                     ; SERVICE_DEMAND_START
ErrorControl   = 1                     ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\PowerDash.sys    ; run from the Driver Store

[Strings]
ManufacturerName="PowerDash Inc."
DiskName="PowerDash Driver Installation Disk"
PowerDash.SVCDESC="PowerDash Driver"
